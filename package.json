{
  "name": "archhive-app",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "bun run plugins:generate",
    "plugins:generate": "bun scripts/generate-plugins.ts",
    "prebuild": "bun run plugins:generate && bun run lint:fix && bun run typecheck && bun run format",
    "prebuild:apk": "bun run typecheck",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:android:dev": "tauri android dev",
    "build:apk": "bun run prebuild:apk && bun run tauri android build --apk -d --target aarch64",
    "build:apk:fast": "tsc && vite build && bun run tauri android build --apk -d --target aarch64",
    "build:apk:release": "bun run plugins:generate && tsc && vite build && bun run tauri android build --apk --target aarch64",
    "build:desktop": "bun run tauri build",
    "version:bump": "bun scripts/bump-version.ts",
    "release": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "android:dev": "powershell -ExecutionPolicy Bypass -File scripts/android-dev.ps1",
    "android:regen": "powershell -ExecutionPolicy Bypass -File scripts/android-regen.ps1",
    "setup:binaries": "powershell -ExecutionPolicy Bypass -File scripts/setup-binaries.ps1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-router": "^1.170.32",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.2",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.35",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6"
  }
}
